# Public configuration only. Leave empty until a real Supabase project exists.
# Run: node --env-file=.env tools/auth-config.mjs
# This generates auth-config.generated.js; review it before replacing auth-config.js.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ORGANIZATION_ID=
# central (default) = business data from the shared database; local = identity only.
VITE_RESIDENTHUB_BUSINESS_DATA=central
